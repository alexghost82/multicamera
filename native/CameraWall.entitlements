<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardware capture & local voice permissions required by ACTA -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Local LAN IP cameras (RTSP/ONVIF) & loopback helper services (go2rtc, vllm-metal) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Required only while FFmpeg dylibs are loaded from /opt/homebrew/opt/ffmpeg outside the bundle.
         Remove before Mac App Store / strict Developer ID notarization once FFmpeg dylibs are bundled and signed inside Contents/Frameworks. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
